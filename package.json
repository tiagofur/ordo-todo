{
  "name": "ordo-todo",
  "private": true,
  "description": "The Modern Task Organization Platform - DDD + Clean Architecture Monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "npm run dev --workspace=@ordo-todo/desktop",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "express": "^5.3.0",
    "cookie": "^0.7.2",
    "cross-spawn": "^7.0.6",
    "semver": "^7.6.3",
    "micromatch": "^4.0.8",
    "xmldom": "npm:@xmldom/xmldom@^0.8.15",
    "@xmldom/xmldom": "^0.8.15",
    "plist": "^3.1.0",
    "qs": "^6.14.0",
    "form-data": "^4.0.6",
    "tough-cookie": "^4.1.3",
    "esbuild": "^0.25.0",
    "hono": "^4.13.7",
    "multer": "^2.5.0",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.6",
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    },
    "tar": "^7.5.21"
  },
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "webpage/*"
  ],
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "immer": "^11.2.9",
    "lucide-react": "^0.577.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  }
}
