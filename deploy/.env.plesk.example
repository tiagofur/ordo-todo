# =============================================================================
# Ordo — variables de entorno de producción (VPS con Plesk)
# =============================================================================
# Copia este fichero a /opt/ordo-todo/.env y rellena los valores. El fichero
# NUNCA se sube a git; guarda una copia en tu gestor de contraseñas.
# El deploy de GitHub Actions exporta IMAGE_TAG con el SHA del commit y
# sobrescribe el valor de aquí (las variables del shell mandan sobre .env).
# -----------------------------------------------------------------------------

# --- Dominios ----------------------------------------------------------------
DOMAIN=ordotodo.app                 # app web (https://ordotodo.app, API en api.ordotodo.app)
MARKETING_DOMAIN=ordotodo.com       # landing / sitio público
# Orígenes CORS extra, con coma inicial. Para las apps Tauri (desktop/móvil):
# CORS_EXTRA_ORIGINS=,tauri://localhost,http://tauri.localhost
CORS_EXTRA_ORIGINS=

# --- Imágenes (GHCR) -----------------------------------------------------------
GITHUB_REPOSITORY_OWNER=tiagofur
IMAGE_TAG=latest                    # backend + web (lo fija el deploy)
MARKETING_IMAGE_TAG=latest          # landing (lo fija deploy-marketing)

# --- Puertos en 127.0.0.1 (Plesk hace proxy a estos) ---------------------------
# El VPS es compartido: 3000/3050/3100/8080/8085/8090 están ocupados por otros
# proyectos y el 5432 por el Postgres del sistema. Ordo no publica Postgres.
API_PORT=3001                       # api.ordotodo.app  -> 127.0.0.1:3001
WEB_PORT=3003                       # ordotodo.app      -> 127.0.0.1:3003
WEBPAGE_PORT=3002                   # ordotodo.com      -> 127.0.0.1:3002

# --- Base de datos -------------------------------------------------------------
# Contraseña: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 32
POSTGRES_USER=ordo_prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ordo_todo_prod
# Volúmenes con nombre fijo. Para empezar con una BD limpia cambia el nombre
# (p. ej. ordo-todo_postgres_data_v2); el volumen antiguo se conserva.
POSTGRES_VOLUME=ordo-todo_postgres_data
UPLOADS_VOLUME=ordo-todo_backend_uploads

# --- Auth ----------------------------------------------------------------------
# JWT_SECRET: mínimo 64 caracteres. Generar: openssl rand -base64 64 | tr -d '\n'
# Rotarlo desloguea a TODOS los usuarios (los refresh tokens dejan de valer).
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME
# 'invite-only' (beta cerrada, por defecto) o 'open'
REGISTRATION_MODE=invite-only
# Correos con acceso a /admin, separados por comas (vacío = tiagofur@gmail.com)
ADMIN_EMAILS=

# --- OAuth (opcional; vacío = botón desactivado) --------------------------------
# Callbacks de producción a registrar en las consolas de Google/GitHub:
#   https://api.ordotodo.app/api/v1/auth/google/callback
#   https://api.ordotodo.app/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (invitaciones, reset de contraseña) ----------------------------------
# Sin SMTP ni Resend los correos SOLO se escriben en el log del backend.
# Opción A: SMTP (p. ej. el mail server de Plesk: buzón no-reply@ordotodo.app,
#           host = hostname del servidor, puerto 587 STARTTLS, SMTP_SECURE=false;
#           puerto 465 requiere SMTP_SECURE=true).
# Opción B: Resend (RESEND_API_KEY) — dominio verificado en Resend.
EMAIL_FROM="Ordo <no-reply@ordotodo.app>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# --- Redis (opcional) -----------------------------------------------------------
# Con una sola instancia no hace falta: caché y blacklist de tokens van en memoria.
REDIS_ENABLED=false
REDIS_URL=

# --- Integraciones opcionales ---------------------------------------------------
GEMINI_API_KEY=
WEBHOOK_SECRET_KEY=
ADMIN_API_KEY=
