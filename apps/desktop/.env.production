# Backend de producción (URL pública, sin secretos).
# `vite build` corre en mode production por defecto, así que `tauri build`
# incrusta esta URL sin necesidad de exportarla a mano — sin este fichero,
# el .env de desarrollo (localhost:3101) acababa dentro del bundle y el
# login de la app instalada golpeaba el backend local de Docker.
# Para apuntar a otro backend, exportar VITE_API_URL al compilar: tiene
# prioridad sobre este fichero.
VITE_API_URL=https://api.ordotodo.app/api/v1
