# Application
NODE_ENV=development
PORT=3101
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ordo_todo"

# JWT (MUST be at least 64 characters - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-secret-key-change-in-production-must-be-64-characters-minimum
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# CORS (la app Expo se eliminó en ODD 020; ya no hay clientes exp:// ni
# Metro en :8081 — si alguno vuelve, añadir su origen aquí)
CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# Logging
LOG_LEVEL=debug

# AI Features (optional - features work without it using fallbacks)
GEMINI_API_KEY=your-gemini-api-key-from-ai-studio

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3101/api/v1/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3101/api/v1/auth/github/callback

# Frontend URL for OAuth redirect
FRONTEND_URL=http://localhost:3000

# Session cookie domain. In production the web (ordotodo.app) must read the
# cookies the API sets from api.ordotodo.app → COOKIE_DOMAIN=ordotodo.app.
# Leave empty in local dev (web and API share localhost).
COOKIE_DOMAIN=

# Redis (optional). When unset or REDIS_ENABLED=false the cache and the refresh
# token blacklist fall back to in-memory storage (fine for a single instance).
REDIS_ENABLED=false
REDIS_URL=

# Email delivery. Without SMTP (or RESEND_API_KEY) emails are only logged.
EMAIL_FROM="Ordo <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Port 587 is STARTTLS (keep false); port 465 needs SMTP_SECURE=true
SMTP_SECURE=false
RESEND_API_KEY=

# ODD 019: registration gate — 'invite-only' (default) requires a valid invite
# code to create an account; 'open' allows public registration.
REGISTRATION_MODE=invite-only

# ODD 019: platform admin emails (comma-separated). Empty defaults to
# tiagofur@gmail.com in code; grants access to /admin endpoints (T4).
ADMIN_EMAILS=
