    "react-i18next": "^16.6.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5",
    "@wxt-dev/module-react": "^1.2.2"
