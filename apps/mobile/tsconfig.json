{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@ordo-todo/api-client": ["../../packages/api-client/src/index.ts"],
      "@ordo-todo/core": ["../../packages/core/src/index.ts"],
      "@ordo-todo/hooks": ["../../packages/hooks/src/index.ts"],
      "@ordo-todo/i18n": ["../../packages/i18n/src/index.ts"],
      "@ordo-todo/stores": ["../../packages/stores/src/index.ts"],
      "@ordo-todo/auth-provider": ["../../packages/auth-provider/src/index.ts"]
    }
  },
  "include": ["src"]
}
