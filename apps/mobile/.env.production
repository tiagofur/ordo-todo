# Backend de producción (URL pública, sin secretos).
# `vite build` corre en mode production por defecto, así que `tauri android
# build` incrusta esta URL sin necesidad de exportarla a mano. Para apuntar
# a otro backend (emulador, LAN), exportar VITE_API_URL al compilar: tiene
# prioridad sobre este fichero.
VITE_API_URL=https://api.ordotodo.app/api/v1
