import { apiClient } from "./api-client";
import type {
  ApiClient,
  UserResponse,
  LoginDto,
  RegisterDto,
  AuthResponse,
  SessionInfo,
} from "@ordo-todo/api-client";

// Extend apiClient with stub methods that don't exist
export const sharedApiClient: ApiClient = {
  login: (data: LoginDto): Promise<AuthResponse> => apiClient.login(data),
  register: (data: RegisterDto): Promise<AuthResponse> =>
    apiClient.register(data),
  logout: (): Promise<void> => apiClient.logout(),
  getCurrentUser: (): Promise<UserResponse> => apiClient.getCurrentUser(),
  getSessions: (): Promise<SessionInfo[]> => (apiClient as any).getSessions?.() ?? [],
  revokeSession: (sessionId: string): Promise<void> => (apiClient as any).revokeSession?.(sessionId) ?? Promise.resolve(),
  revokeAllOtherSessions: (): Promise<void> => (apiClient as any).revokeAllOtherSessions?.() ?? Promise.resolve(),
  getProductivityStreak: (): Promise<{ streak: number; lastDate: Date | null }> =>
    (apiClient as any).getProductivityStreak?.() ?? { streak: 0, lastDate: null },
};
