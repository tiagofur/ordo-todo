{
  "name": "@ordo-todo/auth-provider",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared authentication provider for Ordo-Todo applications (Web, Mobile, Desktop)",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "ordo-todo",
    "auth",
    "authentication",
    "provider",
    "react-context",
    "typescript"
  ],
  "dependencies": {
    "@ordo-todo/api-client": "*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@ordo-todo/typescript-config": "*",
    "@tanstack/react-query": "^5.104.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
