{
  "name": "@ordo-todo/core",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-Driven Design core with entities, value objects, and use cases",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll --collectCoverage",
    "test:ci": "jest --coverage"
  },
  "devDependencies": {
    "@ordo-todo/eslint-config": "*",
    "@ordo-todo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "@types/uuid": "^11.0.0",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "eslint": "^9.39.5",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "jest": "^30.5.2",
    "joycon": "^3.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
