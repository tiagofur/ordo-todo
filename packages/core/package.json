{
  "name": "@ordo-todo/core",
  "version": "0.1.0",
  "private": true,
  "description": "Domain-Driven Design core with entities, value objects, and use cases",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll --collectCoverage",
    "test:ci": "jest --coverage"
  },
  "devDependencies": {
    "@ordo-todo/eslint-config": "*",
    "@ordo-todo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/uuid": "^11.0.0",
    "bundle-require": "^5.1.0",
    "cac": "^7.1.0",
    "eslint": "^10.14.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "jest": "^30.5.2",
    "joycon": "^3.1.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
