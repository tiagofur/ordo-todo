{
  "name": "@ordo-todo/online-status",
  "version": "1.0.0",
  "type": "module",
  "description": "Debounced online/offline status monitor shared by Ordo-Todo apps",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ordo-todo",
    "online-status",
    "connectivity"
  ],
  "devDependencies": {
    "@ordo-todo/typescript-config": "*",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
