{
  "extends": "@ordo-todo/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "declaration": false,
    "declarationMap": false,
    "lib": ["es2022"],
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": ["src/**/*", "vitest.config.ts"]
}
